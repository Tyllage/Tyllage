# Tyllage environment variables.
# Copy to server/.env for local development (the server loads server/.env automatically).
# On Railway, set these in the service's Variables tab. NEVER commit real secrets.

NODE_ENV=development
# Railway injects PORT automatically.
PORT=4000

# PostgreSQL connection string. Railway: reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tyllage
# Set to true when connecting to a Postgres that requires SSL (e.g. a public proxy URL).
DATABASE_SSL=false
# Disposable database used by `npm test` (it is wiped on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tyllage_test

# At least 32 random characters in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Optional. Without a key, Tyllage Connect uses deterministic template (mock) copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. Without credentials, WhatsApp runs in mock mode (payloads are logged, not sent).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Pilot/demo deployments only: seed the fictional ComCrop DEMO data on boot when the database is empty.
SEED_DEMO_ON_START=false

# Allowed browser origin(s) for CORS, comma-separated. Not needed when the API serves the client itself.
CLIENT_URL=http://localhost:5173
